# Copy to .env and fill in (never commit .env)
# Quick check: npm run setup:check

PORT=3001

# ── 1. SUPABASE (database) ─────────────────────────────────────────────
# https://supabase.com/dashboard → New project
# SQL Editor → paste supabase/setup.sql → Run
# Settings → API → copy URL + service_role key (NOT anon)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
RELAY_MODE=supabase

# ── 2. RESEND (activation emails) ──────────────────────────────────────
# https://resend.com → API Keys → Domains (verify your domain first)
RESEND_API_KEY=re_YOUR_KEY
RESEND_FROM_EMAIL=ZoneX Bot <hello@YOUR_DOMAIN.com>

# ── 3. COINBASE COMMERCE (auto payment confirm) ────────────────────────
# https://commerce.coinbase.com → Settings → API keys
# Settings → Webhook subscriptions → shared secret + endpoint URL:
#   https://YOUR_DOMAIN.com/api/webhooks/crypto-billing  (event: charge:confirmed)
COINBASE_API_KEY=YOUR_COINBASE_COMMERCE_API_KEY
CRYPTO_WEBHOOK_SECRET=YOUR_WEBHOOK_SHARED_SECRET

# ── 4. SITE URL (must match live domain / ngrok for dev) ───────────────
APP_URL=https://zonexbot.com
TELEGRAM_OFFICIAL_URL=https://t.me/ZoneXBotOfficial
TELEGRAM_RESULTS_URL=
# Private results channel: paste invite link (t.me/+...) — shared after license only
TELEGRAM_OWNER_URL=https://t.me/zonexowner

# ── 5. PARTNER BROKER ──────────────────────────────────────────────────
PARTNER_REGISTRATION_URL=https://vigco.co/la-com-inv/ChYAH0aZ
PARTNER_BROKER_ID=VIGCO

# ── 6. OPTIONAL: wallet fallbacks (shown if Coinbase charge fails) ─────
PAYMENT_WALLET_BTC=bc1qYOUR_BTC_ADDRESS
PAYMENT_WALLET_ETH=0xYOUR_ETH_ADDRESS
PAYMENT_WALLET_USDT_TRC20=TYOUR_TRON_ADDRESS
PAYMENT_WALLET_USDT_ERC20=0xYOUR_ERC20_ADDRESS

# ── 7. OPTIONAL: Telegram payment alerts ───────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 7b. RESULTS PUBLISHER BOT (npm run results-bot) ────────────────────
# Same bot token OR a dedicated @ZoneXResultsBot from BotFather
# TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_RESULTS_CHANNEL_ID=
TELEGRAM_OFFICIAL_CHANNEL_ID=
RESULTS_POSTS_PER_DAY=3
RESULTS_POST_HOURS_UTC=10,15,20
RESULTS_AUTO_POST=false
RESULTS_AUTO_QUEUE=false
RESULTS_QUEUE_MODE=results
RESULTS_AUTO_CONFIDENCE=0.75
# Optional free local vision (better than OCR on chat screenshots):
# Install: brew install ollama && ollama pull llava:13b
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL=llava:13b

# ── 8. ADMIN LOGIN (username + password) ───────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ZoneXAdmin2026!
# Optional: separate signing secret for session cookies
# ADMIN_SESSION_SECRET=long_random_string
