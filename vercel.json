{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/checkout",
      "dest": "/checkout.html"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    },
    {
      "src": "/terminal/onboarding",
      "dest": "/terminal/onboarding.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    }
  ]
}
