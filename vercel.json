{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "checkout.html",
          "contact.html",
          "zonex-design.css",
          "ux-system.js",
          "relay-controller.js",
          "assets/**",
          "admin/**",
          "terminal/**",
          "dist/**",
          "secure_assets/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
